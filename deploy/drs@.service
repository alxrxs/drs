[Unit]
Description=drs (%i): Windows Hello key-trust device registration and key provisioning
Documentation=https://github.com/alxrxs/drs
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=drs
Group=drs
WorkingDirectory=/opt/drs
# One instance per domain: /etc/drs/<instance>.toml.
ExecStart=/usr/bin/python3 -m drs /etc/drs/%i.toml
Restart=on-failure
RestartSec=2

# 443 without root: the one capability, nothing else.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
UMask=0077
# Keys, keytab and secrets: readable by drs, written by nothing at run time.
ReadOnlyPaths=/etc/drs

[Install]
WantedBy=multi-user.target
